# Copy to .env and fill in. Never commit .env.

# --- Persistence ---
DATABASE_URL="postgresql://localhost:5432/meal_context_eval"   # any Postgres database you created for this tool
BLOB_READ_WRITE_TOKEN=""                                  # optional (hosted blob storage); local dev stores media under .data/

# --- Auth (single-user) ---
AUTH_SECRET="change-me"                                   # any strong secret; the console is cookie-gated

# --- Your data (photos, notes, meal history) — lives OUTSIDE git ---
VANTAGE_DATA_DIR="./data"
VANTAGE_STUDY_YEAR="2026"                                 # year assumed for note headers like "Mar 2"
CORPUS_CUTOFF_EXCLUSIVE=""                                # e.g. "2026-03-01": first day of your test captures; meal history on/after it is refused

# --- LLM providers (a missing key puts that provider's calls in deterministic MOCK mode) ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
# MOCK_LLM="1"                                            # force mock mode for everything (no spend)

# --- Nutrients (USDA FoodData Central; free key: https://fdc.nal.usda.gov/api-key-signup) ---
FDC_API_KEY=""
FDC_DB_VERSION="FDC-2026"

# --- Pinned pipeline settings (defaults shown; see src/lib/config.ts and prompts/PROMPTS.lock.json) ---
# INTERPRET_PROMPT_VERSION="interpret.v4"
# MATCHER_MODEL_ID="gpt-5.1"
# MATCHER_PROMPT_VERSION="match.v3"
# CLASSIFIER_MODEL_ID="gpt-5.1"
# CLASSIFIER_PROMPT_VERSION="classify.v1"
# GT_STRUCTURE_MODEL_ID="gpt-5.1"
# ROSTER="model-id|openai|frontier,model-id|anthropic|cheap"   # models offered on the Run form
# STUDY_VANTAGES="phone,glasses"

# --- Tracing (optional) ---
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="meal-context-eval"
LANGSMITH_TRACING="false"
